<?php

/**
 * @file
 * Functions to support theming in the neo theme.
 */

use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityPublishedInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\neo_back\NeoBackFormActions;
use Drupal\neo_back\NeoBackOfficeHours;

/**
 * Implements hook_theme().
 */
function neo_back_theme() {
  return [
    'entity_edit_form' => [
      'render element' => 'form',
    ],
  ];
}

/**
 * Implements hook_element_info_alter().
 */
function neo_back_element_info_alter(array &$info) {
  // Appended, so it runs after the module's own processOfficeHoursSlot() has
  // built the cells and operation links it adjusts.
  foreach (['office_hours_slot', 'office_hours_exceptions_slot'] as $type) {
    if (isset($info[$type])) {
      $info[$type]['#process'][] = [NeoBackOfficeHours::class, 'processSlot'];
    }
  }
}

/**
 * Implements hook_preprocess_page().
 */
function neo_back_preprocess_page(array &$variables) {
  // A content entity form's actions, copied beside the page title in the
  // sticky header. See NeoBackFormActions.
  if ($actions = NeoBackFormActions::getHeaderActions()) {
    $header = &$variables['page']['header'];
    // A header with no blocks placed arrives as a bare array.
    if (empty($header['#theme_wrappers'])) {
      $header['#theme_wrappers'] = ['region'];
      $header['#region'] = 'header';
    }
    $header['neo_back_form_actions'] = $actions;
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for \Drupal\node\NodeForm.
 *
 * Changes vertical tabs to container.
 */
function neo_back_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  /** @var \Drupal\Core\Entity\EntityFormInterface $form_object */
  $form_object = $form_state->getFormObject();
  if ($form_object instanceof EntityFormInterface) {
    $entity = $form_object->getEntity();
    if ($entity instanceof ContentEntityInterface && !isset($form['#neo_entity_form'])) {
      $form['#neo_entity_form'] = TRUE;
      $entity = $form_object->getEntity();
      $form['#theme'] = 'entity_edit_form';
      // Not a card: the main column and the sidebar are each a surface of
      // their own (see form.css), and a card around both would hide the canvas
      // behind them. 'default' only drops the card class. 'flush' would also
      // zero --spacing-form, which the column gap and the sidebar accordion's
      // inset are measured in.
      $form['#neo_style'] = $form['#neo_style'] ?? 'default';
      neo_back_form_meta($form, $form_state, $entity);
    }
  }
  // Only apply if we have no neo style set.
  $form['#neo_style'] = $form['#neo_style'] ?? 'card';

  switch ($form_id) {
    case 'user_admin_permissions':
    case 'better_permissions_page_user_admin_permissions':
      $form['permissions']['#sticky'] = TRUE;
      // The table is far wider than the screen and every column past the first
      // is an anonymous row of checkboxes, so scrolling right without this
      // leaves you able to see which role a checkbox belongs to but not which
      // permission. The header keys here are role labels, which no auto default
      // recognises, hence the explicit index.
      $form['permissions']['#neo_sticky'][0] = 'left';
      $form['actions']['#neo_style'] = 'sticky';
      // The module group rows are a single cell spanning the whole table, so
      // there is no column for ::resolveStickyColumns() to pin and the module
      // name scrolls away with everything else -- leaving the permissions under
      // it with nothing saying which module they belong to. The cell cannot be
      // pinned itself, being as wide as the table, so the label inside it is:
      // wrapping it gives .sticky--label something to hold in place at the
      // scrollport's edge.
      foreach (Element::children($form['permissions']) as $key) {
        // Core builds these as a lone #markup cell at index 0; a permission row
        // has a 'description' cell and one per role, and no #markup anywhere.
        if (isset($form['permissions'][$key][0]['#markup'])) {
          $form['permissions'][$key][0]['#prefix'] = '<div class="sticky--label">';
          $form['permissions'][$key][0]['#suffix'] = '</div>';
        }
      }
      break;

    case 'dblog_filter_form':
      $form['filters']['#content_attributes']['class'][] = 'form--inline';
      break;

    case 'entity_form_display_edit_form':
    case 'entity_view_display_edit_form':
      $form['fields']['#neo_style'] = [
        0 => 'heading',
        1 => 'xs',
      ];
      $form['fields']['#neo_size'] = [
        0 => 'min',
        1 => 'min',
      ];
      break;
  }
}

function neo_back_preprocess_commerce_order__admin(array &$variables) {
  /** @var \Drupal\commerce_order\Entity\OrderInterface $order */
  $order = $variables['order_entity'];
  $variables['meta_color'] = match($order->getState()->getId()) {
    'draft' => 'bg-base-500 text-base-500-content',
    'canceled' => 'bg-error-500 text-error-500-content',
    default => 'bg-success-500 text-success-500-content',
  };
}

/**
 * Implements meta alterations.
 */
function neo_back_form_meta(&$form, FormStateInterface $form_state, EntityInterface $entity) {
  if (!empty($form['status']) && empty($form['status']['#group'])) {
    $form['status']['#group'] = 'footer';
  }
  if (!empty($form['actions'])) {
    $form['actions']['#weight'] = 1000;
    $form['#after_build'][] = [NeoBackFormActions::class, 'afterBuild'];
  }
  $moderationStateLabel = NULL;
  if (!empty($form['moderation_state'])) {
    $moderationStateLabel = $form['moderation_state']['widget'][0]['current']['#markup'] ?? NULL;
    $form['moderation_state']['#group'] = 'meta';
    if (isset($form['meta']['published'])) {
      $form['moderation_state']['widget'][0]['current']['#access'] = FALSE;
    }
  }
  if (!empty($form['publish_state']['widget'][0]['#options']) && count($form['publish_state']['widget'][0]['#options']) === 1) {
    $form['publish_state']['#access'] = FALSE;
  }
  if (!empty($form['unpublish_state']['widget'][0]['#options']) && count($form['unpublish_state']['widget'][0]['#options']) === 1) {
    $form['unpublish_state']['#access'] = FALSE;
  }
  if (!empty($form['field_metatags']['widget'][0])) {
    $form['field_metatags']['widget'][0]['#icon'] = 'tags';
  }
  if (!empty($form['simple_sitemap'])) {
    $form['simple_sitemap']['#icon'] = 'sitemap';
  }
  if (!empty($form['scheduler_settings'])) {
    $form['scheduler_settings']['#icon'] = 'clock';
  }
  if (!empty($form['path']['widget'][0])) {
    // Collapse the path alias fieldset by default.
    $form['path']['widget'][0]['#open'] = FALSE;
    $form['path']['widget'][0]['#icon'] = 'brackets-curly';
  }
  if (!empty($form['url_redirects'])) {
    $form['url_redirects']['#icon'] = 'directions';
  }
  if (!empty($form['menu'])) {
    $form['menu']['#icon'] = 'list-alt';
  }
  if (!empty($form['author'])) {
    $form['author']['#icon'] = 'user';
  }
  if (!empty($form['advanced'])) {
    $form['advanced']['#type'] = 'accordion';
    $form['advanced']['#wrapper_attributes']['class'][] = '!m-0';
  }

  if (!empty($form['meta'])) {
    $form['meta']['#type'] = 'container';
    $form['meta']['#access'] = TRUE;
    $form['meta']['#attributes']['class'][] = 'p-card text-sm !m-0';

    if (isset($form['meta']['published'])) {
      $form['meta']['#attributes']['class'][] = '!pt-0';
      if ($form['meta']['published']['#type'] === 'html_tag' && isset($form['meta']['published']['#value'])) {
        $form['meta']['published'] = [
          '#type' => 'item',
          '#markup' => $form['meta']['published']['#value'],
        ];
      }
      $form['meta']['published']['#wrapper_attributes']['class'][] = 'mt-0';
      $form['meta']['published']['#wrapper_attributes']['class'][] = '-ml-form-item';
      $form['meta']['published']['#wrapper_attributes']['class'][] = '-mr-form-item';
      $form['meta']['published']['#wrapper_attributes']['class'][] = 'px-form-item';
      $form['meta']['published']['#wrapper_attributes']['class'][] = 'py-4';
      $form['meta']['published']['#wrapper_attributes']['class'][] = 'font-bold';
      $form['meta']['published']['#wrapper_attributes']['class'][] = 'text-md';
      $form['meta']['published']['#wrapper_attributes']['class'][] = 'rounded-t-lg';
      $form['meta']['published']['#wrapper_attributes']['class'][] = 'border-b';
      // Tinted, not filled. A solid status block was the loudest thing on the
      // form and outshouted the Save button; the state still reads from its
      // colour and icon without competing for the eye.
      if ($entity->isNew()) {
        $form['meta']['published']['#access'] = TRUE;
        $form['meta']['published']['#markup'] = neo_icon('Draft');
        $form['meta']['published']['#wrapper_attributes']['class'][] = 'bg-base-100';
        $form['meta']['published']['#wrapper_attributes']['class'][] = 'text-base-700';
        $form['meta']['published']['#wrapper_attributes']['class'][] = 'border-base-200';
      }
      elseif ($entity instanceof EntityPublishedInterface) {
        if ($entity instanceof EntityPublishedInterface && $entity->isPublished()) {
          $form['meta']['published']['#markup'] = neo_icon('Published');
          $form['meta']['published']['#wrapper_attributes']['class'][] = 'bg-success-50';
          $form['meta']['published']['#wrapper_attributes']['class'][] = 'text-success-800';
          $form['meta']['published']['#wrapper_attributes']['class'][] = 'border-success-200';
          if ($moderationStateLabel && $moderationStateLabel !== 'Published') {
            $form['meta']['published']['#markup'] .= ' <span class="font-light">(' . $moderationStateLabel . ')</span>';
          }
        }
        else {
          $form['meta']['published']['#markup'] = neo_icon('Unpublished');
          $form['meta']['published']['#wrapper_attributes']['class'][] = 'bg-warning-50';
          $form['meta']['published']['#wrapper_attributes']['class'][] = 'text-warning-800';
          $form['meta']['published']['#wrapper_attributes']['class'][] = 'border-warning-200';
          if ($moderationStateLabel) {
            $form['meta']['published']['#markup'] .= ' <span class="font-light">(' . $moderationStateLabel . ')</span>';
          }
        }
      }
    }
  }

  if ($statusKey = $entity->getEntityType()->getKey('status')) {
    if (!empty($form[$statusKey])) {
      $form[$statusKey]['#group'] = 'meta';
      $form[$statusKey]['widget']['value']['#neo_size'] = 'sm';
    }
  }

  if (!empty($form['revision_information'])) {
    $form['revision_information']['#type'] = 'container';
    $form['revision_information']['#group'] = 'meta';
    $form['revision_information']['#attributes']['class'][] = 'entity-meta--revision';
  }
}

/**
 * Implements hook_preprocess_form().
 */
function neo_back_preprocess_form(&$variables) {
  // An entity form's surfaces are its columns (see form.css), so its inner
  // wrapper stays clear and unmargined: the columns line up with the page
  // title instead of sitting one form inset further in.
  if (!empty($variables['element']['#neo_entity_form'])) {
    $variables['inner_attributes']->addClass('!m-0');
    return;
  }
  $variables['inner_attributes']->addClass('bg-default');
}

/**
 * Implements template_preprocess_views_view().
 */
function neo_back_preprocess_views_view(&$variables) {
  foreach ([
    'header',
    'footer',
    'empty',
  ] as $region) {
    if (!empty($variables[$region]) && is_array($variables[$region])) {
      $count = 0;
      foreach ($variables[$region] as $key => &$item) {
        if (is_array($item) && isset($item['#type'])) {
          switch ($item['#type']) {
            case 'link':
              $count++;
              break;
          }
        }
      }
      if (count($variables[$region]) === $count) {
        $variables[$region . '_attributes']['class'][] = 'flex gap-2 flex-wrap';
      }
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for inline_entity_form_entity_table.
 *
 * NeoBasePreRender::table() styles a column by its header key: a label as a
 * heading, a status narrow and centred. IEF keys its headers by position, so
 * none of that reaches this table and every column gets an equal share of the
 * width. The same props are set here on each cell instead of on the table,
 * because a positional table prop would also land on the one cell of the row
 * that holds an open edit form.
 */
function neo_back_preprocess_inline_entity_form_entity_table(array &$variables) {
  if (empty($variables['table'])) {
    return;
  }
  $fields = $variables['form']['#table_fields'] ?? [];
  $labelKey = NULL;
  foreach ($fields as $name => $field) {
    if (($field['type'] ?? NULL) === 'label') {
      $labelKey = $name;
      break;
    }
  }

  $table = &$variables['table'];
  $hasStatusIcon = FALSE;
  foreach (Element::children($table) as $key) {
    $row = &$table[$key];
    if (!in_array('ief-row-entity', $row['#attributes']['class'] ?? [], TRUE)) {
      continue;
    }
    // The label column takes whatever width the others leave, so each of the
    // others is sized to its content. The delta select and the operations are
    // not touched: the first is hidden, the second is already sized by its
    // header, and #neo_size on either would restyle it as a form item.
    $handleClasses = $row[0]['#wrapper_attributes']['class'] ?? [];
    if (in_array('ief-tabledrag-handle', $handleClasses, TRUE)) {
      $row[0]['#neo_size'] = 'min';
    }
    foreach (array_keys($fields) as $name) {
      if (!isset($row[$name])) {
        continue;
      }
      if ($name === $labelKey) {
        $row[$name]['#neo_style'] = 'heading';
      }
      // Only a field cell carries #items. One without them was denied view
      // access or built by a callback, and is left as it came.
      elseif ($name === 'status' && isset($row[$name]['#items'])) {
        $published = (bool) $row[$name]['#items']->value;
        // IconTrait::statusIcon(), which a theme cannot call.
        $row[$name] = [
          '#markup' => neo_icon($published ? 'Published' : 'Unpublished')
            ->iconLookup($published ? 'enabled' : 'disabled')
            ->iconOnly(),
          '#neo_size' => 'min',
          '#neo_align' => 'center',
          '#wrapper_attributes' => $row[$name]['#wrapper_attributes'] ?? [],
          '#cache' => $row[$name]['#cache'] ?? [],
        ];
        $hasStatusIcon = TRUE;
      }
      else {
        $row[$name]['#neo_size'] = 'min';
      }
    }
  }
  unset($row);

  if ($hasStatusIcon) {
    $statusClass = 'inline-entity-form-'
      . $variables['form']['#entity_type'] . '-status';
    foreach ($table['#header'] as &$header) {
      if (!is_array($header)) {
        continue;
      }
      if (in_array($statusClass, $header['class'] ?? [], TRUE)) {
        $header['class'][] = 'align--center';
      }
    }
    unset($header);
  }
}

/**
 * Implements hook_form_alter().
 */
function neo_back_form_views_exposed_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (isset($form['secondary'])) {
    // Views exposed filter support.
    $form['secondary']['#attributes']['class'][] = 'form--inline-none';
    $form['secondary']['#weight'] = 1000;
    $form['secondary']['#neo_size'] = 'xs';
    $form['secondary']['#neo_size_inherit'] = FALSE;
  }
}
