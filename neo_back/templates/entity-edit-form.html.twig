{#
/**
 * @file
 * Theme override for a node edit form.
 *
 * Two column template for the node add/edit form.
 *
 * This template will be used when a node edit form specifies 'node_edit_form'
 * as its #theme callback.  Otherwise, by default, node add/edit forms will be
 * themed by form.html.twig.
 *
 * Available variables:
 * - form: The node add/edit form.
 *
 * @see neo_back_form_node_form_alter()
 */
#}
<div class="layout-entity-form">
  <div class="lg:flex lg:gap-form-item">
    <div class="flex-1">
      {{ form|without('advanced', 'footer', 'actions') }}
    </div>
    {% if form.advanced %}
      {{ form.advanced|neo_class('mt-form-item lg:mt-0 lg:w-96') }}
    {% endif %}
  </div>
  {{ form.footer }}
  {{ form.actions }}
  {# <div class="sticky bottom-form-item bg-base-100 mt-form-item">
    <div class="relative z-10 p-form-item border border-base-200 rounded">
      {{ form.footer }}
      {{ form.actions }}
    </div>
    <div class="absolute top-full left-0 z-0 w-full bg-base-0 h-4 pointer-events-none"></div>
  </div> #}
</div>
