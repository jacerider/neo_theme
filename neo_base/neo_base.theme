<?php

/**
 * @file
 * Functions to support theming in the Neo Theme theme.
 */

use Drupal\Component\Utility\Html;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Template\Attribute;
use Drupal\neo_base\NeoBasePreRender;
use Drupal\neo_base\NeoBaseProcess;
use Drupal\neo_icon\IconElementInterface;

/**
 * Implements hook_element_info_alter().
 */
function neo_base_element_info_alter(array &$info) {
  $info['table']['#pre_render'][] = [NeoBasePreRender::class, 'table'];
  $info['field_ui_table']['#pre_render'][] = [NeoBasePreRender::class, 'table'];
  if (isset($info['tableselect'])) {
    $info['tableselect']['#pre_render'][] = [NeoBasePreRender::class, 'table'];
  }
  $info['token_tree_table']['#pre_render'][] = [NeoBasePreRender::class, 'tokenTreeTable'];

  $info['accordion']['#pre_render'] = array_merge([
    [NeoBasePreRender::class, 'neoSize']
  ], $info['accordion']['#pre_render']);
  $info['container']['#pre_render'] = array_merge([
    [NeoBasePreRender::class, 'neoSize']
  ], $info['container']['#pre_render']);
  $info['details']['#pre_render'] = array_merge([
    [NeoBasePreRender::class, 'neoSize'],
    [NeoBasePreRender::class, 'neoRegion'],
  ], $info['details']['#pre_render']);
  $info['fieldset']['#pre_render'] = array_merge([
    [NeoBasePreRender::class, 'neoSize'],
    [NeoBasePreRender::class, 'neoRegion'],
  ], $info['fieldset']['#pre_render']);
  $info['fieldset']['#description_display'] = 'before';
  $info['fieldset']['#content_attributes'] = [];

  $info['vertical_tabs']['#pre_render'][] = [NeoBasePreRender::class, 'verticalTabs'];

  $info['form']['#inner_attributes'] = [];

  $info['radios']['#pre_render'][] = [NeoBasePreRender::class, 'radios'];
  if (!empty($info['commerce_product_rendered_attribute'])) {
    $info['commerce_product_rendered_attribute']['#pre_render'][] = [NeoBasePreRender::class, 'commerceProductRenderedAttribute'];
  }
  $info['radios']['#pre_render'][] = [NeoBasePreRender::class, 'radios'];
  $info['checkboxes']['#pre_render'][] = [NeoBasePreRender::class, 'checkboxes'];

  $info['submit']['#process'] = array_merge([[NeoBaseProcess::class, 'submit']], $info['submit']['#process']);

  foreach ($info as $id => &$element) {
    if (isset($element['#process'])) {
      $supportsGroupProcessing = !empty(array_filter($element['#process'], function ($callback) {
        return is_array($callback) && $callback[1] === 'processGroup';
      }));
      if ($supportsGroupProcessing) {
        $element['#process'][] = [NeoBaseProcess::class, 'group'];
      }
    }
  }
}

/**
 * Implements hook_theme_registry_alter().
 */
function neo_base_theme_registry_alter(&$theme_registry) {
  foreach ($theme_registry as $key => &$theme) {
    if (isset($theme['variables'])) {
      $theme['variables']['neo_style'] = '';
      $theme['variables']['neo_align'] = '';
      $theme['variables']['neo_size'] = '';
    }
  }
}

/**
 * Implements hook_preprocess().
 */
function neo_base_preprocess(array &$variables) {
  $variables['neo_style'] = $variables['neo_style'] ?? $variables['element']['#neo_style'] ?? 'default';
  $variables['neo_align'] = $variables['neo_align'] ?? $variables['element']['#neo_align'] ?? 'default';
  $variables['neo_size'] = $variables['neo_size'] ?? $variables['element']['#neo_size'] ?? 'md';
  if (!empty($variables['neo_size']) && isset($variables['element']) && isset($variables['element']['#parents'])) {
    // We check #parents to see if this is a form element.
    $style = [];
    switch ($variables['neo_size']) {
      case 'xl':
        $style[] = '--spacing-form-item: 1rem;';
        break;
      case 'lg':
        $style[] = '--spacing-form-item: 1rem;';
        break;
      case 'sm':
        $style[] = '--spacing-form-item: 0.75rem;';
        break;
      case 'xs':
        $style[] = '--spacing-form-item: 0.5rem;';
        break;
    }
    if ($style) {
      if (empty($variables['attributes']['style'])) {
        $variables['attributes']['style'] = '';
      }
      $variables['attributes']['style'] .= str_replace(array("\r", "\n"), '', implode("", $style));
    }
  }

}

/**
 * Implements template_preprocess_views_view().
 */
function neo_base_preprocess_views_view(array &$variables) {
  foreach ([
    'header',
    'footer',
    'empty',
  ] as $region) {
    $variables[$region . '_attributes'] = new Attribute($variables[$region . '_attributes'] ?? []);
  }
}

/**
 * Implements hook_preprocess_views_view_table().
 */
function neo_base_preprocess_views_view_table(array &$variables) {
  // $variables['header'] and the style plugin's per-column options share a key,
  // so the neo_sticky an editor picked can be looked up by header key.
  NeoBasePreRender::viewsTable(
    $variables['header'],
    $variables['rows'],
    $variables['view']->style_plugin->options['info'] ?? []
  );
}

/**
 * Implements hook_theme_suggestions_alter().
 */
function neo_base_theme_suggestions_alter(&$suggestions, array &$variables, $hook) {
  if (in_array($hook, ['details', 'fieldset', 'container', 'form_element'])) {
    $suggestions = array_merge([$variables['theme_hook_original'] . '__group'], $suggestions);
  }
  if (isset($variables['element']) && !empty($variables['element']['#group_type'])) {
    $suggestions[] = $variables['theme_hook_original'] . '__group_' . $variables['element']['#group_type'];
  }

  switch ($hook) {
    case 'page':
      $route_name = \Drupal::routeMatch()->getRouteName();
      switch ($route_name) {
        case 'user.login':
        case 'user.register':
        case 'user.pass':
        case 'user.reset.form':
          $suggestions[] = $variables['theme_hook_original'] . '__auth';
          $suggestions[] = $variables['theme_hook_original'] . '__auth__' . str_replace('.', '_', $route_name);
          break;
      }
      break;

    case 'region':
      $route_name = \Drupal::routeMatch()->getRouteName();
      switch ($route_name) {
        case 'user.login':
        case 'user.register':
        case 'user.pass':
        case 'user.reset.form':
          $suggestions[] = $variables['theme_hook_original'] . '__' . $variables['elements']['#region'] . '__auth';
          break;
      }
      break;

    case 'user':
      $suggestions[] = $variables['theme_hook_original'] . '__' . $variables['elements']['#view_mode'];
      break;

    case 'input':
      if (!empty($variables['theme_hook_original'])) {
        if ($variables['theme_hook_original'] === 'input__submit' && !empty($variables['element']['#button_type'])) {
          $suggestions[] = $variables['theme_hook_original'] . '__type_' . $variables['element']['#button_type'];
        }
        if ($variables['theme_hook_original'] === 'input__checkbox') {
          if (!($variables['element']['#belongs_to_checkboxes'] ?? FALSE)) {
            $suggestions[] = $variables['theme_hook_original'] . '_single';
          }
        }
      }
      break;

    case 'form_element_label':
      if (!empty($variables['element']['#element_parent_type'])) {
        $suggestions[] = $variables['theme_hook_original'] . '__type_' . $variables['element']['#element_parent_type'];
      }
      break;

    case 'views_view':
      // Replaced $variables['theme_hook_original'] with $hook because it caused
      // issues on some environments. May have unexpected side effects.
      $suggestions[] = $hook . '__' . $variables['view']->id();
      $suggestions[] = $hook . '__' . $variables['view']->id() . '__' . $variables['view']->current_display;
      break;
  }

  if (in_array($hook, ['fieldset', 'container', 'form_element'])) {
    $element_type = $variables['element']['#type'] ?? $variables['element']['value']['#type'] ?? '';
    if ($element_type !== $hook) {
      $suggestions[] = $variables['theme_hook_original'] . '__type_' . $element_type;
      if ($element_type === 'checkbox') {
        if (!empty($variables['element']['#parents']) && end($variables['element']['#parents']) !== $variables['element']['#return_value']) {
          $suggestions[] = $variables['theme_hook_original'] . '__type_' . $element_type . '_single';
        }
      }
    }
  }
  if (in_array($hook, ['container']) && isset($variables['element']['#type']) && $variables['element']['#type'] === 'container' && isset($variables['element']['#array_parents'])) {
    // Get the last key in the array parents.
    $key = end($variables['element']['#array_parents']);
    if (strpos($key, '_bulk_form') !== FALSE) {
      $suggestions[] = $variables['theme_hook_original'] . '__bulk_form';
      $suggestions[] = $variables['theme_hook_original'] . '__' . $key;
    }

    foreach ($variables['element']['#array_parents'] as $delta => $key) {
      if ($key === 'widget') {
        $parts = array_filter(array_splice($variables['element']['#array_parents'], $delta + 1), function ($part) {
          return !is_int($part);
        });
        if (!empty($parts)) {
          $suggestions[] = $variables['theme_hook_original'] . '__widget_' . preg_replace('/[0-9]+/', '', implode('_', $parts));
        }
      }
    }
  }

  if ($hook === 'form_element' && empty($variables['element']['#parents']) && empty($variables['element']['#array_parents'])) {
    $suggestions[] = $variables['theme_hook_original'] . '__formless';
  }
}

/**
 * Prepares variables for HTML document templates.
 *
 * Default template: html.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - page: A render element representing the page.
 */
function neo_base_preprocess_html(array &$variables) {
  $variables['attributes']['class'][] = Html::getClass('theme--' . \Drupal::service('theme.manager')->getActiveTheme()->getName());
  $variables['attributes']['class'][] = 'form--style';
}

/**
 * Implements hook_preprocess_item_list().
 */
function neo_base_preprocess_item_list(array &$variables) {
  // Do not show a wrapper if there are no attributes.
  $variables['wrapper'] = !empty($variables['wrapper_attributes']->toArray());
}

/**
 * Implements hook_preprocess_field().
 */
function neo_base_preprocess_field(array &$variables) {
  $variables['items_attributes'] = new Attribute($variables['element']['#items_attributes'] ?? []);
}

/**
 * Implements hook_preprocess_fieldset().
 */
function neo_base_preprocess_fieldset(array &$variables) {
  if (!empty($variables['element']['#wrapper_attributes'])) {
    $attributes = new Attribute($variables['attributes'] ?? []);
    $attributes->merge(new Attribute($variables['element']['#wrapper_attributes']));
    $variables['attributes'] = $attributes->toArray();
  }
  if (isset($variables['element']['#type'])) {
    $elementType = $variables['element']['#type'];
    if ($elementType === 'radios') {
      $variables['element_id'] = $variables['element']['#id'] . '--wrapper';
    }
  }
  $variables['content_attributes'] = new Attribute($variables['element']['#content_attributes'] ?? $variables['content_attributes'] ?? []);
  $variables['neo_region'] = $variables['element']['#neo_region'] ?? [];
}

/**
 * Implements hook_preprocess_details().
 */
function neo_base_preprocess_details(array &$variables) {
  $variables['open'] = $variables['element']['#open'] ?? FALSE;
  $variables['summary_title_attributes'] = new Attribute($variables['element']['#summary_title_attributes'] ?? $variables['summary_title_attributes'] ?? []);
  $variables['content_attributes'] = new Attribute($variables['element']['#content_attributes'] ?? $variables['content_attributes'] ?? []);
  $variables['description_attributes'] = new Attribute($variables['element']['#description_attributes'] ?? $variables['description_attributes'] ?? []);
  $variables['neo_region'] = $variables['element']['#neo_region'] ?? [];
}

/**
 * Implements hook_preprocess_input__submit().
 */
function neo_base_preprocess_input__submit(array &$variables) {
  $variables['title'] = $variables['element']['#title'] ?? $variables['element']['#value'];
  $variables['as_input'] = !empty($variables['element']['#as_input']);
  $variables['disabled'] = !empty($variables['element']['#disabled']);
  if (!is_array($variables['title'])) {
    $variables['attributes']['data-label'] = Html::getClass(trim(strip_tags(strtolower($variables['title']))));
  }
  $style = [];
  if (!empty($variables['neo_size'])) {
    switch ($variables['neo_size']) {
      case 'xl':
        $variables['attributes']['class'][] = 'btn-xl';
        break;
      case 'lg':
        $variables['attributes']['class'][] = 'btn-lg';
        break;
      case 'sm':
        $variables['attributes']['class'][] = 'btn-sm';
        break;
      case 'xs':
        $variables['attributes']['class'][] = 'btn-xs';
        break;
    }
  }
  if (!empty($variables['neo_style'])) {
    // We inline style these so that classes are not generated in the master
    // stylesheet.
    $neoStyle = $variables['neo_style'];
    switch ($neoStyle) {
      case 'reset':
        $style[] = "
          --btn-bg-color: transparent;
          --btn-bg-color-hover: transparent;
          --btn-content-color: currentColor;
          --btn-content-color-hover: currentColor;
          --btn-border-color: transparent;
          --btn-border-color-hover: transparent;
          --btn-border-width: 0;
          --btn-py: 0;
          --btn-px: 0;
          border-style: none;
        ";
        break;

      case 'primary':
      case 'secondary':
      case 'accent':
      case 'success':
      case 'warning':
      case 'alert':
        $style[] = "
          --btn-bg-color: var(--btn-{$neoStyle}-bg-color, rgb(var(--color-{$neoStyle}-500)));
          --btn-bg-color-hover: var(--btn-{$neoStyle}-bg-color-hover, rgb(var(--color-{$neoStyle}-700)));
          --btn-content-color: var(--btn-{$neoStyle}-content-color, rgb(var(--color-{$neoStyle}-500-content)));
          --btn-content-color-hover: var(--btn-{$neoStyle}-content-color-hover, rgb(var(--color-{$neoStyle}-700-content)));
        ";
        break;

      case 'outline':
        $style[] = "
          --btn-bg-transparent: transparent;
          --btn-bg-color-hover: var(--btn-bg-color, rgb(var(--color-base-500)));
          --btn-border-color: var(--btn-bg-color, rgb(var(--color-base-500)));
          --btn-border-color-hover: var(--btn-bg-color, rgb(var(--color-base-500)));
          --btn-content-color: var(--btn-bg-color, rgb(var(--color-base-500)));
        ";
        break;

      case 'primary-outline':
      case 'secondary-outline':
      case 'accent-outline':
      case 'success-outline':
      case 'warning-outline':
      case 'alert-outline':
        $neoStyle = str_replace('-outline', '', $neoStyle) ?: '';
        $style[] = "
          --btn-bg-transparent: transparent;
          --btn-bg-color-hover: var(--btn-{$neoStyle}-bg-color, rgb(var(--color-{$neoStyle}-500)));
          --btn-content-color: var(--btn-{$neoStyle}-bg-color, rgb(var(--color-{$neoStyle}-500)));
          --btn-content-color-hover: var(--btn-{$neoStyle}-content-color-hover, rgb(var(--color-{$neoStyle}-500-content)));
          --btn-border-color: var(--btn-{$neoStyle}-bg-color, rgb(var(--color-{$neoStyle}-500)));
          --btn-border-color-hover: var(--btn-{$neoStyle}-bg-color, rgb(var(--color-{$neoStyle}-500)));
        ";
        break;

      case 'text':
        $style[] = "
          --btn-bg-transparent: transparent;
          --btn-bg-color-hover: transparent;
          --btn-content-color: var(--btn-bg-color, rgb(var(--color-base-500)));
          --btn-content-color-hover: var(--btn-bg-color, rgb(var(--color-base-500)));
          --btn-text-decoration-hover: underline;
        ";
        $variables['attributes']['class'][] = 'first:pl-0 last:pr-0';
        break;

      case 'text-primary':
      case 'text-secondary':
      case 'text-accent':
      case 'text-success':
      case 'text-warning':
      case 'text-alert':
        $neoStyle = str_replace('text-', '', $neoStyle);
        $style[] = "
          --btn-bg-transparent: transparent;
          --btn-bg-color-hover: transparent;
          --btn-content-color: var(--btn-$neoStyle-bg-color, rgb(var(--color-$neoStyle-500)));
          --btn-content-color-hover: var(--btn-$neoStyle-bg-color, rgb(var(--color-$neoStyle-700)));
          --btn-border-color: transparent;
          --btn-border-color-hover: transparent;
          --btn-text-decoration-hover: underline;
        ";
        $variables['attributes']['class'][] = 'first:pl-0 last:pr-0';
        break;
    }
  }
  if ($style) {
    if (empty($variables['attributes']['style'])) {
      $variables['attributes']['style'] = '';
    }
    foreach ($style as &$st) {
      $st = explode("\n", $st);
      foreach ($st as &$line) {
        $line = trim($line);
      }
      $st = implode("", $st);
    }
    $variables['attributes']['style'] .= str_replace(array("\r", "\n"), '', implode("", $style));
  }
}

/**
 * Implements hook_preprocess_input__submit().
 */
function neo_base_preprocess_input__checkbox_single(array &$variables) {
  $variables['container_attributes'] = new Attribute($variables['element']['#container_attributes'] ?? []);
  $variables['inner_attributes'] = new Attribute($variables['element']['#inner_attributes'] ?? []);
  if (
    !empty($variables['attributes']['class']) &&
    is_array($variables['attributes']['class']) &&
    in_array('js-hide', $variables['attributes']['class'])) {
      // Apply the js-hide class to the container attributes.
      $variables['container_attributes']->addClass('js-hide');
  }
}

/**
 * Implements hook_preprocess_input().
 */
function neo_base_preprocess_input(array &$variables) {
  $variables['disabled'] = $variables['element']['#disabled'] ?? FAlSE;
}

/**
 * Implements hook_preprocess_form_element_label().
 */
function neo_base_preprocess_form_element_label(array &$variables) {
  $variables['disabled'] = $variables['element']['#disabled'] ?? FAlSE;
  if (isset($variables['title']['#markup']) && is_array($variables['title']['#markup'])) {
    // Allow labels to use render arrays.
    $variables['title'] = $variables['title']['#markup'];
  }
}

/**
 * Implements hook_preprocess_form().
 */
function neo_base_preprocess_form(array &$variables) {
  $variables['inner_attributes'] = new Attribute($variables['element']['#inner_attributes'] ?? []);
  // We re-apply .form--style so that .scheme-* can target it.
  $variables['attributes']['class'][] = 'form--style';
}

/**
 * Implements hook_preprocess_block().
 */
function neo_base_preprocess_block(array &$variables) {
  // Add id to template.
  $variables['id'] = '';
  if (isset($variables['elements']['#id'])) {
    $variables['id'] = 'block--' . str_replace('_', '-', $variables['elements']['#id']);
  }
}

/**
 * Implements hook_preprocess_form_element().
 */
function neo_base_preprocess_form_element(array &$variables) {
  $variables['label']['#element_parent_type'] = $variables['element']['#type'] ?? '';
  $variables['label']['#neo_style'] = $variables['element']['#neo_style'] ?? 'default';
  $variables['label']['#neo_align'] = $variables['element']['#neo_align'] ?? 'default';
  $variables['label']['#neo_size'] = $variables['element']['#neo_size'] ?? 'md';
  $variables['label']['#disabled'] = $variables['element']['#disabled'] ?? FALSE;
  if (!empty($variables['element']['#label_attributes'])) {
    $attributes = new Attribute($variables['label']['#attributes']);
    $attributes->merge(new Attribute($variables['element']['#label_attributes']));
    $variables['label']['#attributes'] = $attributes->toArray();
  }
  $variables['element_id'] = $variables['element']['#id'] ?? '';
}

/**
 * Implements hook_preprocess_form_element().
 */
function neo_base_preprocess_radios(array &$variables) {
  if (!empty($variables['element']['#wrapper_attributes'])) {
    $attributes = new Attribute($variables['attributes']);
    $attributes->merge(new Attribute($variables['element']['#wrapper_attributes']));
    $variables['attributes'] = $attributes->toArray();
  }
}

/**
 * Implements hook_preprocess_form_element().
 */
function neo_base_preprocess_checkboxes(array &$variables) {
  if (!empty($variables['element']['#wrapper_attributes'])) {
    $attributes = new Attribute($variables['attributes']);
    $attributes->merge(new Attribute($variables['element']['#wrapper_attributes']));
    $variables['attributes'] = $attributes->toArray();
  }
}

/**
 * Implements hook_preprocess_form_element().
 */
function neo_base_preprocess_textarea(array &$variables) {
  if (($variables['element']['#rows'] ?? 5) <= 1) {
    return;
  }
  // Kinda ugly bug we only want this running on CKEditor instances and this
  // works for now.
  if (isset($variables['element']['#attributes']['data-media-embed-host-entity-langcode'])) {
    $variables['wrapper_attributes']->addClass('prose max-w-none font-primary');
    // Add the prose library to the page. If it does not exist, it will be
    // ignored.
    $variables['#attached']['library'][] = 'front/prose';
  }
}

/**
 * Implements hook_preprocess_field_multiple_value_form().
 */
function neo_base_preprocess_field_multiple_value_form(array &$variables) {
  if (!empty($variables['button'])) {
    $variables['button']['#attributes']['class'][] = 'btn btn-xs';
  }
  if (!empty($variables['table'])) {
    foreach ($variables['table']['#rows'] as &$row) {
      foreach ($row['data'] as $key => $cell) {
        if (isset($row['data'][$key]['data']) && is_array($row['data'][$key]['data'])) {
          if ($key == 0) {
            $row['data'][$key]['data']['#neo_size'] = 'min';
          }
          if ($key == 2) {
            $row['data'][$key]['data']['#neo_size'] = 'min';
          }
        }
      }
    }
  }
}

/**
 * Implements hook_preprocess_page().
 */
function neo_base_preprocess_page(array &$variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  switch ($route_name) {
    case 'user.login':
    case 'user.register':
    case 'user.pass':
    case 'user.reset.form':
      $variables['attributes']['class'][] = 'user--auth';
      $uri = $variables['base_path'] . $variables['directory'] . '/logo.svg';
      if (!file_exists(ltrim($uri, '/'))) {
        $uri = $variables['base_path'] . $variables['directory'] . '/logo.png';
      }
      if (file_exists(ltrim($uri, '/'))) {
        $variables['logo'] = [
          '#theme' => 'image',
          '#uri' => $uri,
        ];
      }
      break;
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function neo_base_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $form['#after_build'][] = 'neo_base_form_after_build';
  $form['#attached']['library'][] = 'neo_base/form';

  // Preprocess views bulk operations.
  neo_base_form_alter_views_bulk_operations($form);

  // Preprocess all form buttons.
  neo_base_preprocess_buttons($form);
}

/**
 * Alter views bulk operations form.
 */
function neo_base_form_alter_views_bulk_operations(&$form) {
  if (isset($form['header']['views_bulk_operations_bulk_form'])) {
    $form['header']['views_bulk_operations_bulk_form']['select_all']['#neo_size'] = 'xs';
    $form['header']['views_bulk_operations_bulk_form']['multipage']['#neo_size'] = 'sm';
    $form['header']['views_bulk_operations_bulk_form']['multipage']['#group_type'] = 'views_bulk_operations';
    $form['header']['views_bulk_operations_bulk_form']['multipage']['clear']['#attributes']['class'][] = 'btn btn-xs w-full md:w-auto';
    $form['header']['views_bulk_operations_bulk_form']['multipage']['list']['#wrapper_attributes']['class'][] = 'text-xs';
    if (!empty($form['header']['views_bulk_operations_bulk_form']['multipage']['list']['#items'])) {
      $form['header']['views_bulk_operations_bulk_form']['multipage']['list']['#wrapper_attributes']['class'][] = 'mb-2';
    }
    else {
      $form['header']['views_bulk_operations_bulk_form']['multipage']['clear']['#access'] = FALSE;
    }
    $form['header']['views_bulk_operations_bulk_form']['actions']['submit']['#attributes']['class'][] = 'btn btn-xs w-full md:w-auto';
  }
}

/**
 * Form after build callback.
 */
function neo_base_form_after_build($form, FormStateInterface $form_state) {
  $form['#neo_style'] = $form['#neo_style'] ?? 'default';
  $form['#neo_size'] = $form['#neo_size'] ?? 'default';
  $form['#attributes']['data-neo-style'] = $form['#neo_style'];
  $form['#attributes']['data-neo-size'] = $form['#neo_size'];
  return $form;
}

/**
 * Preprocess buttons.
 *
 * Currently used to properly handle buttons with icons as the #value. Drupal
 * does not handle this well and we need to set the #title to the icon and the
 * #value to the text.
 *
 * @param array $element
 *   The element to preprocess.
 */
function neo_base_preprocess_buttons(&$element) {
  if (is_array($element)) {
    if (isset($element['#type']) && $element['#type'] === 'submit') {
      if (isset($element['#value']) && $element['#value'] instanceof IconElementInterface) {
        $element['#title'] = $element['#value'];
        $element['#value'] = $element['#value']->getText();
        $element['#attributes']['class'][] = 'has-icon';
      }
    }
    else {
      foreach (Element::children($element) as $key) {
        neo_base_preprocess_buttons($element[$key]);
      }
    }
  }
}

/**
 * Implements hook_preprocess_file_managed_file().
 */
function neo_base_preprocess_file_managed_file(array &$variables) {
  if (!empty($variables['element']['remove_button'])) {
    $variables['element']['remove_button']['#neo_size'] = 'xs';
  }
}

/**
 * Implements hook_preprocess_node().
 */
function neo_base_preprocess_node(array &$variables) {
  if (isset($variables['elements']['#page'])) {
    $variables['page'] = !empty($variables['elements']['#page']);
  }
}

/**
 * Implements hook_preprocess_taxonomy_term().
 */
function neo_base_preprocess_taxonomy_term(array &$variables) {
  if (isset($variables['elements']['#page'])) {
    $variables['page'] = !empty($variables['elements']['#page']);
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function neo_base_form_user_login_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $form['actions']['submit']['#button_type'] = 'primary';
  $form['actions']['submit']['#attributes']['class'][] = 'w-full';
}

