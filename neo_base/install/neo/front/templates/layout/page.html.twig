{#
/**
 * @file
 * Theme override to display a single page.
 *
 * @see template_preprocess_page()
 * @see html.html.twig
 */
#}
{%
  set page_classes = [
    'section',
    'page',
    'font-primary',
    'flex',
    'flex-col',
    'min-h-displace',
  ]
%}
<div{{ attributes.addClass(page_classes) }}>

  {{ page.sidebar }}

  <div class="section main" role="main">
    {{ page.header }}
    <main class="flex">
      <div class="w-full main--content">
        {{ page.status }}
        {{ page.content }}
      </div>
    </main>
  </div>
  <footer class="mt-auto">
    {{ page.footer }}
  </footer>

</div>{# /.layout-container #}
