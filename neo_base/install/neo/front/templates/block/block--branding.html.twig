{% extends 'block.html.twig' %}

{% block content %}
  {% if site_logo %}
    <a href="{{ path('<front>') }}" rel="home" class="block focus transition">
      <img src="{{ site_logo }}" alt="{{ 'Home'|t }}" fetchpriority="high" class="block h-14" />
    </a>
  {% endif %}
  {% if site_name %}
    <a href="{{ path('<front>') }}" class="sr-only" rel="home">{{ site_name }}</a>
  {% endif %}
  {{ site_slogan }}
{% endblock %}
