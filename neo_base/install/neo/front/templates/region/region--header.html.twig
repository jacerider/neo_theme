{% extends 'region.html.twig' %}

{#
  Specify the classes for the region.
#}
{% set classes = ['shadow sticky top-displace-t z-30 bg-base-50'] %}

{#
  Specify the classes for the region inner wrapper.
  If no classes are set, the region will not have an inner wrapper.
#}
{% set inner_classes = ['container flex w-full mx-auto px-container py-4'] %}

{#
  Set the attributes for the region.
  We set the 'data-neo-offset-top' attribute so that the Neo offset
  can calculate the top offset for this sticky element.
#}
{% set attributes = attributes.setAttribute('data-neo-offset-top', '') %}
