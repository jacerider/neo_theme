{% extends 'fieldset--group.html.twig' %}

{%
  set attributes = attributes.addClass('media-library-wrapper relative')
%}

{% block prefix %}
  {% if prefix %}
    <span class="block text-sm media-library-widget--prefix">
      {% if prefix.weight_toggle %}
        {{ prefix.weight_toggle|add_class('compact-link compact-float') }}
      {% endif %}
      {{ prefix|without('weight_toggle') }}
    </span>
  {% endif %}
{% endblock %}

{% block children %}
  <div>
    {{ children }}
  </div>
{% endblock %}

{% block suffix %}
  <span class="block text-sm media-library-widget--suffix">{{ suffix }}</span>
{% endblock %}

{% block description %}
  <div{{ description.attributes.addClass('!mt-2', base_description_classes, description_classes) }}>{{ description.content }}</div>
{% endblock %}
