{#
/**
 * @file
 * Theme override to display a region.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region <div>.
 * - region: The name of the region variable as defined in the theme's
 *   .info.yml file.
 *
 * @see template_preprocess_region()
 */
#}
{%
  set base_classes = base_classes is defined ? base_classes : [
    'region',
    'region--' ~ region|clean_class,
  ]
%}
{%
  set classes = classes is defined ? classes : []
%}
{%
  set inner_classes = inner_classes is defined ? inner_classes : []
%}
{% if content %}
  <{{ tag|default('div') }}{{ attributes.addClass(base_classes, classes) }}>
    {% if inner_classes is not empty %}
      {% set inner_attributes = create_attribute()  %}
      <div{{ inner_attributes.addClass(inner_classes) }}>
    {% endif %}
    {{ content }}
    {% if inner_classes is not empty %}
      </div>
    {% endif %}
  </{{ tag|default('div') }}>
{% endif %}
