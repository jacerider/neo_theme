{#
/**
 * @file
 * Default theme implementation to display a single Drupal page while offline.
 *
 * All available variables are mirrored in page.html.twig.
 * Some may be blank but they are provided for consistency.
 *
 * @see template_preprocess_maintenance_page()
 *
 * @ingroup themeable
 */
#}
{%
  set page_classes = [
    'section',
    'page',
  ]
%}

<div{{ attributes.addClass(page_classes) }}>
  <a id="main-content" tabindex="-1"></a>
  <div class="section main flex items-center justify-center min-h-displace bg-base-100" role="main">
    <div class="max-w-xl border bg-base-0 shadow rounded my-6 w-full p-6 grid grid-cols-1 gap-6">
      {% if logo %}
        <div class="flex flex-col items-center">
          <img src="{{ logo }}" alt="{{ 'Home'|t }}"/>
        </div>
      {% endif %}

      {% if site_name or site_slogan %}
        {% if site_name %}
          <h1 class="text-2xl font-bold my-0 text-center">
            <a href="{{ front_page }}" title="{{ 'Home'|t }}" rel="home">{{ site_name }}</a>
          </h1>
        {% endif %}

        {% if site_slogan %}
          <div class="text-sm italic text-center">{{ site_slogan }}</div>
        {% endif %}
      {% endif %}

      {{ page.status }}
      <div class="card bg-alert-100 text-alert-700 border-alert-500 text-sm p-3">
        {{ page.content }}
      </div>
    </div>
  </div>
</div>{# /.layout-container #}
