{#
/**
 * @file
 * Default theme implementation to display a single Drupal page while offline.
 *
 * All available variables are mirrored in page.html.twig.
 * Some may be blank but they are provided for consistency.
 *
 * @see template_preprocess_maintenance_page()
 *
 * @ingroup themeable
 */
#}
<div class="maintenance-page section page relative isolate flex min-h-displace flex-col items-center justify-center overflow-hidden bg-gradient-to-b from-primary-600 to-primary-800 px-6 py-16 text-center text-base-0">
  <a id="main-content" tabindex="-1"></a>

  {# Soft decorative glow. #}
  <div class="pointer-events-none absolute -top-1/3 left-1/2 -z-10 h-[44rem] w-[44rem] -translate-x-1/2 rounded-full bg-primary-400 opacity-20 blur-3xl"></div>

  <div class="flex w-full max-w-md flex-col items-center gap-10" role="main">

    {# Brand logo. #}
    {% if logo %}
      <img src="{{ logo }}" alt="{{ site_name|default('Home'|t) }}" class="h-8 w-auto"/>
    {% endif %}

    {# Animated status medallion. #}
    <div class="relative flex h-28 w-28 items-center justify-center">
      <span class="absolute h-full w-full animate-ping rounded-full bg-primary-300 opacity-20"></span>
      <span class="absolute h-full w-full rounded-full bg-primary-500"></span>
      <span class="relative flex h-20 w-20 items-center justify-center rounded-full bg-base-0 text-primary-600 shadow-xl">
        <svg class="h-10 w-10 animate-spin [animation-duration:9s]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
        </svg>
      </span>
    </div>

    {# Heading and message. #}
    <div class="flex flex-col gap-4">
      <h1 class="my-0 font-heading text-3xl font-bold tracking-tight md:text-4xl">
        {{ "We'll be right back"|t }}
      </h1>

      {{ page.highlighted }}

      <div class="text-base leading-relaxed text-primary-100 md:text-lg">
        {{ page.content }}
      </div>
    </div>

    {% if site_slogan %}
      <div class="text-sm italic text-primary-200">{{ site_slogan }}</div>
    {% endif %}

  </div>
</div>
