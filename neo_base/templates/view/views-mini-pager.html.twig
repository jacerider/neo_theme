{#
/**
 * @file
 * Default theme implementation for a views mini-pager.
 *
 * Available variables:
 * - heading_id: Pagination heading ID.
 * - pagination_heading_level: The heading level to use for the pager.
 * - items: List of pager items.
 *
 * @see template_preprocess_views_mini_pager()
 *
 * @ingroup themeable
 */
#}
{%
  set base_info_classes = base_info_classes is defined ? base_info_classes : [
    'relative',
    'block',
    'text-sm',
    'font-medium',
    'text-default',
    'px-4',
    'py-2',
    'border',
    'first:rounded-s',
    'last:rounded-e',
    '-my-px',
  ]
%}
{%
  set info_classes = info_classes is defined ? info_classes : [
    'bg-base-50',
    'text-base-50-content',
    'border-base-200',
  ]
%}
{%
  set base_item_classes = base_item_classes is defined ? base_item_classes : [
    'transition',
    'focus:ring',
    'focus:z-10',
    'focus:outline-none',
  ]
%}
{%
  set item_classes = item_classes is defined ? item_classes : [
    'hover:bg-base-100',
    'hover:text-base-content-100',
    'focus:ring-primary-600',
    'focus:text-primary-700',
  ]
%}
{% if items.previous or items.next %}
  <nav class="pager" role="navigation" aria-labelledby="{{ heading_id }}">
    <{{ pagination_heading_level }} id="{{ heading_id }}" class="visually-hidden">{{ 'Pagination'|t }}</{{ pagination_heading_level }}>
    <div class="js-pager__items inline-flex -space-x-px">
      {% if items.previous %}
        <a href="{{ items.previous.href }}" title="{{ 'Go to previous page'|t }}" rel="prev"{{ items.previous.attributes.addClass(base_info_classes, info_classes, base_item_classes, item_classes)|without('href', 'title', 'rel') }}>
          <span class="visually-hidden">{{ 'Previous page'|t }}</span>
          <span aria-hidden="true">{{ items.previous.text|default('‹‹'|t) }}</span>
        </a>
      {% endif %}
      {% if items.current %}
        {% set current_attributes = create_attribute() %}
        <div{{ current_attributes.addClass(base_info_classes, info_classes) }}>
          {% trans %}
            Page {{ items.current }}
          {% endtrans %}
        </div>
      {% endif %}
      {% if items.next %}
        <a href="{{ items.next.href }}" title="{{ 'Go to next page'|t }}" rel="next"{{ items.next.attributes.addClass(base_info_classes, info_classes, base_item_classes, item_classes)|without('href', 'title', 'rel') }}>
          <span class="visually-hidden">{{ 'Next page'|t }}</span>
          <span aria-hidden="true">{{ items.next.text|default('››'|t) }}</span>
        </a>
      {% endif %}
    </div>
  </nav>
{% endif %}
