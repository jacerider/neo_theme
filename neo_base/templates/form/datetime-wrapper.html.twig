{#
/**
 * @file
 * Default theme implementation of a datetime form wrapper.
 *
 * Available variables:
 * - content: The form element to be output, usually a datelist, or datetime.
 * - title: The title of the form element.
 * - title_attributes: HTML attributes for the title wrapper.
 * - description: Description text for the form element.
 * - required: An indicator for whether the associated form element is required.
 *
 * @see template_preprocess_datetime_wrapper()
 *
 * @ingroup themeable
 */
#}
<div class="form-item">
{%
  set title_classes = [
    required ? 'js-form-required',
    required ? 'form-required',
    'form-label',
  ]
%}
{% if title %}
  <label{{ title_attributes.addClass(title_classes) }}>
    {{ title }}
    {% if required %}
      <abbr class="font-normal form-required text-alert" aria-hidden="true">{% if title is empty %}<span class="text-xs">{{ 'Required'|t }}</span>{% endif %} *</abbr>
      {% if title is not empty %}
        <span class="visually-hidden">{{ 'required'|t }}</span>
      {% endif %}
    {% else %}
      {# Support states #}
      <abbr class="hidden font-normal text-alert is-required:inline-block" aria-hidden="true">*</abbr>
    {% endif %}
  </label>
{% endif %}
<div class="form--inline">
  {{ content }}
</div>
{% if errors %}
  <div>
    {{ errors }}
  </div>
{% endif %}
{% if description %}
  <div{{ description_attributes.addClass('description') }}>
    {{ description }}
  </div>
{% endif %}
</div>
