{% extends 'input.html.twig' %}

{#
  `inline_buttons` renders the control as a segmented text button: the input goes
  `sr-only` (not hidden — it stays focusable and operable by keyboard) and the
  wrapping label becomes the chip. See form-element--type-checkbox-single.html.twig.

  The grouped path (input--checkbox.html.twig) does the same thing, but its chip
  styling keys off `checked-prev:` — an adjacent-sibling selector. It cannot be
  reused here: this template nests the input inside a positioning div, so the
  label is not the input's sibling. The single path uses `has-[:checked]:`.
#}
{%
  set buttons = neo_style in ['inline_buttons', 'inline_buttons_outline', 'inline_buttons_text']
%}
{%
  set classes = [
    'block',
    'transition',
    'form-item-focus',
    disabled ? 'cursor-not-allowed' : 'cursor-pointer',
    buttons ? 'sr-only',
    neo_style == 'reset' ? 'rounded checked:bg-form-item-primary checked:hover:bg-form-item-primary checked:focus:bg-form-item-primary',
    neo_style == 'default' ? 'peer form-item-border form-item-bg rounded-full checked:bg-none',
    neo_style == 'default' and neo_size == 'xl' ? 'w-14 h-10',
    neo_style == 'default' and neo_size == 'lg' ? 'w-12 h-8',
    neo_style == 'default' and neo_size == 'md' ? 'w-10 h-6',
    neo_style == 'default' and neo_size == 'sm' ? 'w-8 h-5',
    neo_style == 'default' and neo_size == 'xs' ? 'w-6 h-4',
  ]
%}

{%
  set inner_classes = [
    disabled ? 'cursor-not-allowed' : 'cursor-pointer',
    neo_style == 'default' ? 'absolute flex items-center justify-center rounded-full transition bg-form-item-accent dot left-1 top-1 peer-checked:bg-form-item-base pointer-events-none',
    neo_style == 'default' and neo_size == 'xl' ? 'w-8 h-8 peer-checked:translate-x-4',
    neo_style == 'default' and neo_size == 'lg' ? 'w-6 h-6 peer-checked:translate-x-4',
    neo_style == 'default' and neo_size == 'md' ? 'w-4 h-4 peer-checked:translate-x-4',
    neo_style == 'default' and neo_size == 'sm' ? 'h-3 w-3 peer-checked:translate-x-3',
    neo_style == 'default' and neo_size == 'xs' ? 'h-2 w-2 peer-checked:translate-x-2',
  ]
%}

{% block input %}
  {% if buttons %}
    {# No track and no knob — the label carries the whole visual. #}
    <input{{ attributes.addClass(classes) }} role="switch" />{{ children }}
  {% else %}
    <div{{ container_attributes.addClass('relative p-0!') }}>
      <input{{ attributes.addClass(classes) }} role="switch" />{{ children }}
      <div{{ inner_attributes.addClass(inner_classes) }}></div>
    </div>
  {% endif %}
{% endblock %}
