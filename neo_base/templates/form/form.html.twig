{#
/**
 * @file
 * Default theme implementation for a 'form' element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 *
 * @ingroup themeable
 */
#}
{%
  set classes = classes is defined ? classes : [
    'form--wrapper mt-form first:mt-0',
    neo_style == 'card' ? 'card',
  ]
%}

{%
  set inner_classes = inner_classes is defined ? inner_classes : [
    'form--inner flex-1 my-form modal:my-0',
    'text-default',
  ]
%}

{% if neo_size == 'xs' %}
  {% set attributes = attributes.setAttribute('style', '--spacing-form: 0px; --spacing-form-item: 0.5rem;') %}
{% elseif neo_size == 'sm' %}
  {% set attributes = attributes.setAttribute('style', '--spacing-form: 0px; --spacing-form-item: 1rem;') %}
{% elseif neo_style == 'flush' %}
  {% set attributes = attributes.setAttribute('style', '--spacing-form: 0px;') %}
{% endif %}

{{ attach_library('neo_base/form') }}
<form{{ attributes.addClass('form', classes) }}>
  <div{{ inner_attributes.addClass(inner_classes) }}>
    {% block children %}
      {{ children }}
    {% endblock %}
  </div>
</form>
