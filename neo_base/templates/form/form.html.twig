{#
/**
 * @file
 * Default theme implementation for a 'form' element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 *
 * @ingroup themeable
 */
#}
{%
  set classes = classes is defined ? classes : [
    'form--wrapper',
    not neo_style ? 'card',
    'first:mt-0',
  ]
%}
{%
  set inner_classes = inner_classes is defined ? inner_classes : [
    'form--inner',
  ]
%}
{% set inner_attributes = create_attribute()  %}

{{ attach_library('neo_base/form') }}
<form{{ attributes.addClass('form', classes) }}>
  <div{{ inner_attributes.addClass(inner_classes) }}>
    {{ children }}
  </div>
</form>
