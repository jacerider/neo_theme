{#
/**
 * @file
 * Default theme implementation for a details element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the details element.
 * - errors: (optional) Any errors for this details element, may not be set.
 * - title: (optional) The title of the element, may not be set.
 * - summary_attributes: A list of HTML attributes for the summary element.
 * - description: (optional) The description of the element, may not be set.
 * - children: (optional) The children of the element, may not be set.
 * - value: (optional) The value of the element, may not be set.
 * - is_tab: (optional) Will be TRUE if the details element is a tab.
 *
 * @see template_preprocess_details()
 *
 * @ingroup themeable
 */
#}
{%
  set classes = classes is defined ? classes : ['py-form-item']
%}
{%
  set summary_classes = summary_classes is defined ? summary_classes : []
%}
{%
  set base_summary_classes = [
    required ? 'js-form-required',
    required ? 'form-required',
  ]
%}
{%
  set summary_title_classes = summary_title_classes is defined ? summary_title_classes : ['details--title']
%}
{%
  set content_classes = content_classes is defined ? content_classes : ['details--content']
%}
{%
  set description_classes = description_classes is defined ? description_classes : ['details--description', 'text-xs', 'my-4']
%}
{%
  set use_alpine = use_alpine is defined ? use_alpine : false
%}
{% if use_alpine %}
  {{ attach_library('neo/library.alpine.collapse') }}
{% endif %}
<{% if use_alpine %}div{% else %}details{% endif %}{{ attributes.addClass(classes) }}{% if use_alpine %} x-data="{ expanded: {% if open %}true{% else %}false{% endif %} }"{% endif %}>
  {%- if title -%}
    <div{{ summary_attributes.addClass(base_summary_classes, summary_classes) }}{% if use_alpine %} @click="expanded = ! expanded"{% endif %}>
      {% block summary %}
        <summary>
          <div{{ summary_title_attributes.addClass(summary_title_classes) }}>{{ title }}</div>
        </summary>
      {% endblock %}
    </div>
  {%- endif -%}

  {% if use_alpine %}<div x-show="expanded" x-collapse x-cloak>{% endif %}
  <div{{ content_attributes.addClass(content_classes) }}>
    {% if errors %}
      <div>
        {{ errors }}
      </div>
    {% endif %}

    {% if description %}
      <div{{ description_attributes.addClass(description_classes) }}>
        {{ description }}
      </div>
    {% endif %}

    {{ children }}
    {{ value }}
  </div>
  {% if use_alpine %}</div>{% endif %}
</{% if use_alpine %}div{% else %}details{% endif %}>
