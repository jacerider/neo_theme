{#
/**
 * @file
 * Default theme implementation for a form element label.
 *
 * Available variables:
 * - title: The label's text.
 * - title_display: Elements title_display setting.
 * - required: An indicator for whether the associated form element is required.
 * - attributes: A list of HTML attributes for the label.
 * - neo_tooltip_help: Set when the field's description was moved into a
 *   tooltip. Carries only `label`, the accessible name for the trigger; the
 *   glyph and its sizing are decided here. See neo_tooltip_preprocess_form_element().
 *
 * @see template_preprocess_form_element_label()
 *
 * @ingroup themeable
 */
#}
{%
  set base_classes = base_classes is defined ? base_classes : [
    title_display == 'after' ? 'option',
    title_display == 'invisible' ? 'visually-hidden',
    required ? 'js-form-required',
    required ? 'form-required',
  ]
%}
{%
  set classes = classes is defined ? classes : [
    'form-label',
    neo_align == 'inline' ? 'pr-1 whitespace-nowrap',
  ]
%}
{% if title is not empty or required -%}
  {% block label %}
    <{{ tag|default('label') }}{{ attributes.addClass(base_classes, classes) }}>
      {{ title }}
      {% if required %}
        <abbr class="font-normal form-required text-alert" aria-hidden="true">{% if title is empty %}<span class="text-xs">{{ 'Required'|t }}</span>{% endif %} *</abbr>
        {% if title is not empty %}
          <span class="visually-hidden">{{ 'required'|t }}</span>
        {% endif %}
      {% else %}
        {# Support states #}
        <abbr class="hidden font-normal text-alert is-required:inline-block" aria-hidden="true">*</abbr>
      {% endif %}
      {#
        A button, not the <a href="" onclick="return false"> the tooltip builder
        reaches for elsewhere: this has to be reachable by Tab and operable on
        touch, where there is no hover to reveal the tooltip at all, and a
        button is both without any script to cancel a navigation.

        No tooltip attributes on it. tooltip.ts adds it to the triggerTarget of
        the instance already bound to the field, so the icon and the field open
        one tooltip rather than two carrying the same sentence.
      #}
      {% if neo_tooltip_help %}
        <button type="button"
                data-neo-tooltip-help
                class="form-label-help"
                aria-label="{{ neo_tooltip_help.label }}">
          {#
            A character, not an icon-font glyph: `form-label-help` draws the
            badge and centres this inside it, so there is no baseline to correct
            and nothing to render wrong if the icon font never loads.
            aria-hidden because the button's aria-label is the accessible name.
          #}
          <span aria-hidden="true">?</span>
        </button>
      {% endif %}
    </{{ tag|default('label') }}>
  {% endblock %}
{%- endif %}
