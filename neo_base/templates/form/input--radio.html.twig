{% extends 'input.html.twig' %}

{%
  set classes = [
    'form-item-border',
    'form-item-bg',
    'form-item-focus',
    'text-primary-500',
    'transition',
    disabled ? 'cursor-not-allowed' : 'cursor-pointer',
    neo_style in ['inline_buttons', 'inline_buttons_outline'] ? 'sr-only',
    neo_style == 'inline_elements' ? '',
    neo_style == 'grid_buttons' ? 'sr-only',
    neo_size == 'xs' ? 'w-4 h-4',
    neo_size == 'sm' ? 'w-4 h-4',
    neo_size == 'md' ? 'w-5 h-5',
    neo_size == 'lg' ? 'w-8 h-8',
    neo_size == 'xl' ? 'w-10 h-10',
  ]
%}
