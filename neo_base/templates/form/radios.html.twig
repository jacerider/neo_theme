{#
/**
 * @file
 * Default theme implementation for a 'radios' #type form element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The rendered radios.
 *
 * @see template_preprocess_radios()
 *
 * @ingroup themeable
 */
#}
{%
  set classes = classes is defined ? classes : [
    neo_style == 'inline' ? 'flex flex-wrap',
    neo_style == 'inline_buttons' ? 'flex flex-wrap',
    neo_style == 'inline_elements' ? 'flex flex-wrap',
    neo_style == 'inline_elements' and neo_size == 'xl' ? 'gap-4',
    neo_style == 'inline_elements' and neo_size == 'lg' ? 'gap-3',
    neo_style == 'inline_elements' and neo_size == 'md' ? 'gap-2',
    neo_style == 'inline_elements' and neo_size == 'sm' ? 'gap-1.5',
    neo_style == 'inline_elements' and neo_size == 'xs' ? 'gap-1',
    neo_style == 'grid_buttons' ? 'grid',
    neo_style == 'grid_buttons' and neo_size == 'xl' ? 'gap-4',
    neo_style == 'grid_buttons' and neo_size == 'lg' ? 'gap-3',
    neo_style == 'grid_buttons' and neo_size == 'md' ? 'gap-2',
    neo_style == 'grid_buttons' and neo_size == 'sm' ? 'gap-1.5',
    neo_style == 'grid_buttons' and neo_size == 'xs' ? 'gap-1',
  ]
%}
<div{{ attributes.addClass(classes) }}>{{ children }}</div>
