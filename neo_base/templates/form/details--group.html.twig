{% extends 'details.html.twig' %}

{%
  set classes = [
    'border border-form-item-base-200',
    'form--item',
    'details',
  ]
%}
{%
  set summary_classes = [
    'relative',
    'flex',
    'flex-wrap',
    'cursor-pointer',
    'list-none',
    'items-center',
    'transition',
    'rounded-sm',
    'text-form-item-label',
    'hover:text-form-item-primary',
    'hover:bg-form-item-base-50',
    'form-item-focus',
    '[&>.summary]:w-full',
    '[&>.summary]:text-xs',
    '[&>.summary]:font-light',
    '[&>.summary]:leading-tight',
    '[&>.summary]:ml-7',
    neo_size == 'xl' ? 'p-4 font-bold text-xl',
    neo_size == 'lg' ? 'p-4 font-bold text-lg',
    neo_size == 'md' ? 'p-4 font-bold',
    neo_size == 'sm' ? 'px-4 py-2 font-semibold text-sm',
    neo_size == 'xs' ? 'px-4 py-1 font-semibold text-xs',
    required ? 'js-form-required',
    required ? 'form-required',
  ]
%}
{%
  set content_classes = [
    'm-form-item',
  ]
%}

{%
  set use_alpine = use_alpine is defined ? use_alpine : false
%}

{% block summary %}
  <div class="w-7 grow-0">
    <svg class="transform" fill="none" height="20" width="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"{% if use_alpine %} :class="{ 'rotate-180': expanded }"{% endif %}>
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </div>
  <div{{ summary_title_attributes.addClass('details--title') }}>{{ title }}</div>
{% endblock %}
