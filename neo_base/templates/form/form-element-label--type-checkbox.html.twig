{% extends 'form-element-label.html.twig' %}

{%
  set classes = [
    'text-form-item-label',
    disabled ? 'cursor-not-allowed' : 'cursor-pointer',
    neo_size == 'xl' ? 'text-xl',
    neo_size == 'lg' ? 'text-lg',
    neo_size == 'md' ? 'text-md',
    neo_size == 'sm' ? 'text-sm',
    neo_size == 'xs' ? 'text-xs',
    neo_style == 'default' ? 'pl-1.5',
    neo_style == 'reset' ? 'ml-2',
    neo_style == 'inline' ? 'pl-1.5',
    neo_style == 'inline_buttons' ? 'block form-item-focus form-item-bg rounded leading-none ml-0 transition-all checked-prev:bg-form-item-primary checked-prev:text-form-item-primary-content',
    neo_style == 'inline_buttons' and neo_size == 'xl' ? 'p-4',
    neo_style == 'inline_buttons' and neo_size == 'lg' ? 'p-3',
    neo_style == 'inline_buttons' and neo_size == 'md' ? 'p-2',
    neo_style == 'inline_buttons' and neo_size == 'sm' ? 'p-1.5',
    neo_style == 'inline_buttons' and neo_size == 'xs' ? 'p-1',
    neo_style == 'inline_elements' ? 'pl-2 [&>div]:m-0',
    neo_style == 'grid_buttons' ? 'flex items-center justify-center flex-1 leading-none ml-0 form-item-border-radius form-item-border form-item-focus transition-all checked-prev:bg-form-item-primary checked-prev:text-form-item-primary-content',
    neo_style == 'grid_buttons' and neo_size == 'xl' ? 'p-4',
    neo_style == 'grid_buttons' and neo_size == 'lg' ? 'p-3',
    neo_style == 'grid_buttons' and neo_size == 'md' ? 'p-2',
    neo_style == 'grid_buttons' and neo_size == 'sm' ? 'p-1.5',
    neo_style == 'grid_buttons' and neo_size == 'xs' ? 'p-1',
  ]
%}

