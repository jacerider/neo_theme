{% extends 'fieldset.html.twig' %}

{%
  set classes = [
    'card',
    'text-base',
    'form--item',
    legend.title is empty or description_display == 'before' and description.content is empty ? 'pt-0',
  ]
%}
{%
  set legend_classes = []
%}
{%
  set legend_span_classes = [
    'font-bold',
    'text-base',
    '[&>.form-item]:my-0',
  ]
%}
{%
  set content_classes = content_classes is defined ? content_classes : [
    'clearfix',
    '[&>p]:my-form-item',
    '[&>p]:text-sm',
    '[&>.field-prefix]:text-sm',
    '[&>.field-prefix]:block',
    '[&>.field-prefix]:mb-2',
    title_display != 'invisible' ? '[&>*:first-child]:!mt-form-item',
  ]
%}
