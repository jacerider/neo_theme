{% extends 'fieldset.html.twig' %}

{%
  set classes = [
    'bg-form-item-base-50',
    'text-form-item-label',
    'form--item',
    neo_style == 'default' ? 'border border-form-item-base-200',
    legend.title is empty or description_display == 'before' and description.content is empty ? 'pt-0',
  ]
%}
{%
  set legend_classes = []
%}
{%
  set legend_span_classes = [
    'text-base',
    'p-form-item',
    '[&>.form-item]:my-0',
    neo_size == 'xl' ? 'font-bold text-xl',
    neo_size == 'lg' ? 'font-bold text-lg',
    neo_size == 'md' ? 'font-bold',
    neo_size == 'sm' ? 'font-semibold text-sm',
    neo_size == 'xs' ? 'font-semibold text-xs',
  ]
%}
{%
  set content_classes = [
    'mx-form-item',
    neo_size == 'xl' ? 'mb-form-item',
    title_display == 'invisible' and neo_size == 'xl' ? 'mt-4',
    neo_size == 'lg' ? 'mb-form-item',
    title_display == 'invisible' and neo_size == 'lg' ? 'mt-4',
    neo_size == 'md' ? 'mb-form-item',
    title_display == 'invisible' and neo_size == 'md' ? 'mt-4',
    neo_size == 'sm' ? 'mb-2',
    title_display == 'invisible' and neo_size == 'sm' ? 'mt-2',
    neo_size == 'xs' ? 'mb-2',
    title_display == 'invisible' and neo_size == 'xs' ? 'mt-2',
    '[&>p]:text-sm',
    '[&>.field-prefix]:text-sm',
    '[&>.field-prefix]:block',
    '[&>.field-prefix]:mb-2',
  ]
%}
{# Spacing is not being used #}
{%
  set spacing_classes = [
    title_display != 'invisible' and neo_size == 'xl' ? 'mt-4',
    title_display != 'invisible' and neo_size == 'lg' ? 'mt-4',
    title_display != 'invisible' and neo_size == 'md' ? 'mt-4',
    title_display != 'invisible' and neo_size == 'sm' ? 'mt-2',
    title_display != 'invisible' and neo_size == 'xs' ? 'mt-2',
  ]
%}
