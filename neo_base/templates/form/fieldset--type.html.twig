{% extends 'fieldset.html.twig' %}

{%
  set classes = [
    'border border-form-item-base-200',
    'text-base',
    'form--item',
    'p-6',
  ]
%}
{%
  set legend_classes = [
    'flex',
    'flex-col',
    'items-center',
    'md:flex-row',
    'mb-6',
  ]
%}
{%
  set legend_span_classes = [
    'font-bold',
    'text-base',
  ]
%}
{%
  set content_classes = content_classes is defined ? content_classes : [
    '[&>*:last-child]:mb-0',
    '[&>p]:my-form-item',
    '[&>p]:text-sm',
  ]
%}
