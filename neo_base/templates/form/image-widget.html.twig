{#
/**
 * @file
 * Default theme implementation for an image field widget.
 *
 * Available variables:
 * - attributes: HTML attributes for the containing element.
 * - data: Render elements of the image widget.
 *
 * @see template_preprocess_image_widget()
 *
 * @ingroup themeable
 */
#}
{% if data.preview %}
{%
  set classes = classes is defined ? classes : [
    'flex',
    'gap-form-item',
    'items-center',
    'form-item-bg',
    'form-item-border',
    'form-item-border-radius',
    'py-2',
    'px-3',
    'text-base',
    'leading-tight',
    'w-full',
    'text-xs',
    'hover:border-inherit',
    '[&>.file]:text-sm',
  ]
%}
{% endif %}
<div{{ attributes.addClass(classes) }} style="border-color: var(--form-item-border)">
  {{ data.preview }}
  {# Render widget data without the image preview that was output already. #}
  <div class="lg:whitespace-nowrap lg:flex gap-form-item items-center">{{ data|without('preview') }}</div>
</div>
