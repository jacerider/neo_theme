{% extends 'input.html.twig' %}

{%
  set classes = [
    'form-item-border',
    'form-item-bg',
    'form-item-focus',
    'rounded',
    'checked:bg-primary-500',
    'text-primary-500',
    'transition',
    disabled ? 'cursor-not-allowed' : 'cursor-pointer',
    neo_style == 'inline_buttons' ? 'sr-only',
    neo_style == 'inline_elements' ? '',
    neo_style == 'grid_buttons' ? 'sr-only',
    neo_size == 'xs' ? 'p-1.5',
    neo_size == 'sm' ? 'p-1',
    neo_size == 'md' ? 'p-2',
    neo_size == 'lg' ? 'p-3',
    neo_size == 'xl' ? 'p-4',
  ]
%}
