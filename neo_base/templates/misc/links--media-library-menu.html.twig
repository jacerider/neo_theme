{{ attach_library('neo_base/horizontal-tabs')}}
{% if links -%}
<div class="horizontal-tabs mb-form-item font-bold">
  <ul{{ attributes.addClass('horizontal-tabs-list') }}>
    {%- for item in links -%}
      <li>
        {%- if item.link -%}
          {{ item.link|neo_class('horizontal-tab-button') }}
        {%- elseif item.text_attributes -%}
          <span{{ item.text_attributes }}>{{ item.text }}</span>
        {%- else -%}
          {{ item.text }}
        {%- endif -%}
      {%- endfor -%}
    </li>
  </ul>
</div>
{%- endif %}
