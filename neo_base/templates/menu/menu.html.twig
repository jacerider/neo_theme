{#
/**
 * @file
 * Neo's theme implementation for the main menu.
 *
 * Available variables:
 * - menu_name: The machine name of the menu.
 * - items: A nested list of menu items. Each menu item contains:
 *   - attributes: HTML attributes for the menu item.
 *   - below: The menu item child items.
 *   - title: The menu link title.
 *   - url: The menu link URL, instance of \Drupal\Core\Url
 *   - localized_options: Menu link localized options.
 *   - is_expanded: TRUE if the link has visible children within the current
 *     menu tree.
 *   - is_collapsed: TRUE if the link has children within the current menu tree
 *     that are not currently visible.
 *   - in_active_trail: TRUE if the link is in the active trail.
 *
 * @ingroup themeable
 */
#}
{% import _self as menus %}

{%
  set base_classes = base_classes is defined ? base_classes : [
    'menu',
    'menu--' ~ menu_name|clean_class,
  ]
%}
{%
  set classes = classes is defined ? classes : []
%}
{%
  set depth_classes = depth_classes is defined ? depth_classes : []
%}
{%
  set base_item_classes = base_item_classes is defined ? base_item_classes : [
    'menu--item',
  ]
%}
{%
  set item_classes = item_classes is defined ? item_classes : []
%}
{%
  set base_link_classes = base_link_classes is defined ? base_link_classes : [
    'menu--link',
  ]
%}
{%
  set link_classes = link_classes is defined ? link_classes : []
%}
{%
  set anchor_classes = anchor_classes is defined ? anchor_classes : link_classes
%}
{%
  set item_depth_classes = item_depth_classes is defined ? item_depth_classes : []
%}
{%
  set link_depth_classes = link_depth_classes is defined ? link_depth_classes : []
%}

{#
  We call a macro which calls itself to render the full tree.
  @see https://twig.symfony.com/doc/3.x/tags/macro.html
#}
{% set attributes = attributes.addClass(base_classes, classes) %}
{%
  set item_classes = base_item_classes|merge(item_classes)
%}
{%
  set link_classes = base_link_classes|merge(link_classes)
%}
{%
  set anchor_classes = base_link_classes|merge(anchor_classes)
%}
{{ menus.menu_links(items, attributes, 0, depth_classes, item_classes, link_classes, anchor_classes, item_depth_classes, link_depth_classes) }}

{% macro menu_links(items, attributes, menu_level, depth_classes, item_classes, link_classes, anchor_classes, item_depth_classes, link_depth_classes) %}
  {% import _self as menus %}
  {% if items %}
    {%
      set instance_depth_classes = depth_classes[(menu_level + 1)] is defined ? depth_classes[(menu_level + 1)] : []
    %}
    {% if menu_level == 0 %}
      {% set attributes = attributes.merge(attributes).addClass(instance_depth_classes) %}
    {% else %}
      {% set attributes = create_attribute().addClass(instance_depth_classes) %}
    {% endif %}
    {% set level = 'menu--level-' ~ (menu_level + 1) %}
    <ul {{ attributes.addClass(level) }}>
      {% for item in items %}

        {% if item.url.isRouted and item.url.routeName == '<nolink>' %}
          {% set menu_item_type = 'nolink' %}
        {% elseif item.url.isRouted and item.url.routeName == '<button>' %}
          {% set menu_item_type = 'button' %}
        {% else %}
          {% set menu_item_type = 'link' %}
        {% endif %}

        {%
          set instance_item_classes = [
            'menu--item-' ~ menu_item_type,
            'menu--item-level-' ~ (menu_level + 1),
            item.in_active_trail ? 'menu--item-active-trail',
            item.below ? 'menu--item-has-children',
          ]
        %}

        {%
          set instance_item_depth_classes = item_depth_classes[(menu_level + 1)] is defined ? item_depth_classes[(menu_level + 1)] : []
        %}

        {%
          set instance_link_depth_classes = link_depth_classes[(menu_level + 1)] is defined ? link_depth_classes[(menu_level + 1)] : []
        %}

        {%
          set instance_link_classes = [
            'menu--link-' ~ menu_item_type,
            'menu--link-level-' ~ (menu_level + 1),
            item.in_active_trail ? 'menu--link-active-trail',
            item.below ? 'menu--link-has-children',
          ]
        %}

        <li{{ item.attributes.addClass(item_classes, instance_item_classes, instance_item_depth_classes) }}>
          {#
            A unique HTML ID should be used, but that isn't available through
            Twig yet, so the |clean_id filter is used for now.
            @see https://www.drupal.org/project/drupal/issues/3115445
          #}
          {% set aria_id = (item.title ~ '-submenu-' ~ loop.index)|clean_id %}

          {% if item.prefix %}
            <div class="menu--prefix">
              {{ item.prefix }}
            </div>
          {% endif %}

          {% if menu_item_type == 'nolink' and anchor_classes %}
            {{ link(item.title, item.url, {'class': anchor_classes|merge(instance_link_classes)|merge(instance_link_depth_classes)}) }}
          {% else %}
            {{ link(item.title, item.url, {'class': link_classes|merge(instance_link_classes)|merge(instance_link_depth_classes)}) }}
          {% endif %}

          {% if item.suffix %}
            <div class="menu--suffix">
              {{ item.suffix }}
            </div>
          {% endif %}

          {% if item.below %}
            {{ menus.menu_links(item.below, attributes, menu_level + 1, depth_classes, item_classes, link_classes, anchor_classes, item_depth_classes, link_depth_classes) }}
          {% endif %}

        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
