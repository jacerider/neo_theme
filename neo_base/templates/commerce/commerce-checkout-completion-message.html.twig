{#
/**
 * @file
 * Default theme implementation for the completion message.
 *
 * Available variables:
 * - order_entity: The order entity.
 * - message: The completion message.
 * - payment_instructions: The payment instructions, if provided.
 *
 * @ingroup themeable
 */
#}
<div class="checkout-complete">
  <div class="prose max-w-none">
    <p class="font-bold">{{ 'You will receive an order confirmation email with the details of your order/quote. You will be contacted by a representative in 24 hours to confirm and review order/quote.'|t }}</p>
    {{- message -}}
  </div>

  {% if payment_instructions %}
    <div class="checkout-complete__payment-instructions">
      <h2>{{ 'Payment instructions'|t }}</h2>
      {{ payment_instructions }}
    </div>
  {% endif %}
</div>
